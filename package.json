{
  "name": "nexio-ide",
  "version": "0.1.0",
  "private": true,
  "description": "Editor IA multiplataforma con agentes, plugins y sandbox local.",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "prepare": "husky install"
  },
  "keywords": [
    "electron",
    "react",
    "monaco",
    "ai",
    "plugins",
    "typescript"
  ],
  "author": "Nexio",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron": "^31.7.1",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.0.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.1",
    "ts-jest": "^29.1.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/tests/e2e/"
    ]
  }
}
